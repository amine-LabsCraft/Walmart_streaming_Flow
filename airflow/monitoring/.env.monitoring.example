# Change this password before exposing Grafana outside localhost.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-with-a-long-password

# The exporter reads the local walmart-source-db container directly.

# Disabled by default because a SQL warehouse query can wake Databricks compute.
WALMART_DATABRICKS_METRICS_ENABLED=false
WALMART_GOLD_TABLE=walmart.gold.fact_orders
