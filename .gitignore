# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Build and distribution artifacts
build/
dist/
wheels/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables and secrets
.env
.env.*
!.env.example
!airflow/monitoring/.env.monitoring.example

# Local database connection notes
**/PostgreConnexion.txt

# Preserved metadata from the former nested local repository
**/.git.local-backup/

# Airflow local files
.airflow/
airflow.db
airflow.cfg
logs/

# dbt generated files
dbt_project/target/
dbt_project/dbt_packages/
dbt_project/logs/
target/
dbt_packages/

# Databricks local state
.databricks/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo

# Operating system files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
*.log


# dbt profiles with secrets
airflow/walmart_dbt/profiles.yml
airflow/walmart_dbt/profiles_Git.yml

# Runtime-only Prometheus service discovery generated by the local app
airflow/monitoring/runtime/*.json
!airflow/monitoring/runtime/.gitkeep